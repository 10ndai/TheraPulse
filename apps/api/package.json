{
  "name": "@therapulse/api",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "11.1.17",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.17",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.2",
    "@therapulse/shared": "*",
    "bcrypt": "6.0.0",
    "helmet": "8.1.0",
    "otplib": "12.0.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.4",
    "@nestjs/testing": "11.1.17",
    "@swc/cli": "0.8.0",
    "@swc/core": "1.15.21",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "25.5.0",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "7.2.0",
    "@vitest/coverage-v8": "4.1.1",
    "prisma": "6.19.2",
    "supertest": "7.2.2",
    "tsx": "4.19.3",
    "typescript": "6.0.2",
    "unplugin-swc": "1.5.9",
    "vitest": "4.1.1"
  }
}
